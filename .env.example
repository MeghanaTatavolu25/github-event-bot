# Fake values only. Copy to .env and fill in real ones. Never commit .env.
# One variable per line, NAME=value, no quotes. The value must NOT repeat the name.
# Make a random secret:  python -c "import secrets; print(secrets.token_hex(32))"

# MongoDB Atlas connection string. If the password has special characters (@ : / ? # %), URL-encode it.
MONGODB_URI=mongodb+srv://fake_user:fake_password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# GitHub OAuth App (Settings > Developer settings > OAuth Apps). Callback: APP_URL + /auth/callback
GITHUB_CLIENT_ID=fake_github_client_id
GITHUB_CLIENT_SECRET=fake_github_client_secret

# Shared secret that signs webhooks. Any long random string; the same value is given to GitHub for every hook.
GITHUB_WEBHOOK_SECRET=fake_webhook_secret_use_a_long_random_string

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/FAKE/FAKE/fakefakefake

# Signs the login cookie and encrypts stored GitHub tokens. Changing it signs everyone out.
SESSION_SECRET=fake_session_secret_use_a_long_random_string

# Where this app is reachable, no trailing slash.
#   local:  http://localhost:8000
#   Render: https://github-event-bot-jeuz.onrender.com
APP_URL=http://localhost:8000
